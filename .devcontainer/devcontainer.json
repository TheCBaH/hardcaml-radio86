{
  "name": "hardcaml-radio86",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "upgradePackages": false
    },
    "ghcr.io/devcontainers/features/sshd:1": {},
    "ghcr.io/thecbah/ocaml-features/ocaml:1": {
      "version": "${localEnv:OCAML_VERSION:5.4.1}",
      "packages": "bytesrw cmdliner dune fmt hwfrp jsont menhir ocamlformat#0.28.1 ppx_expect qcheck-core rivet",
      "pin-packages": "zipc git+https://github.com/dbuenzli/zipc.git#4335e845388b05b9161c8fd58b4ef4363819e43b,unlz4 git+https://github.com/TheCBaH/ocaml-unlz4.git#f5446abf9a4ce4beb92b02ee958f345a6c8171bd,fst git+https://github.com/TheCBaH/ocaml-fst.git#32d68870539fb7422c86e5d8fc62db8568b173a7,ovcd git+https://github.com/TheCBaH/ovcd.git#9e6d53af48db166d095a506ed350682c7683b48b,err_trace git+https://github.com/TheCBaH/err_trace.git#1c7a6ba94c81c70008c594c709e7d37feb38f435,hwfrp git+https://github.com/TheCBaH/coralview.git#e78a32bea0c433612a880f05dc39e60f766185cf,rivet git+https://github.com/TheCBaH/rivet.git#932dcbd88b2b35846f5959d9d6a9ac2fcf695d91"
    }
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "OPAMROOT": "/opt/opam",
    "RIVET_EXTERNAL_DEPS": "true"
  },
  "postCreateCommand": {
    "opam": "sudo .devcontainer/fix-opam-owner.sh $(id -u) $(id -g)"
  },
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "ocamllabs.ocaml-platform"
      ]
    }
  }
}
