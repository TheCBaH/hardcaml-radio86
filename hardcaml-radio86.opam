# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Observation of an Intel 8080 from waveform traces"
description:
  "Reads Verilator or Cyclesim waveforms of an 8080 with hwfrp and decodes bus transfers, instructions and register state, checked in lockstep against Rivet's behavioural model."
maintainer: ["Vladimir Silyaev"]
authors: ["Vladimir Silyaev"]
license: "MIT"
homepage: "https://github.com/TheCBaH/hardcaml-radio86"
bug-reports: "https://github.com/TheCBaH/hardcaml-radio86/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "4.14"}
  "hwfrp"
  "rivet"
  "jsont"
  "bytesrw"
  "cmdliner"
  "ppx_expect" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/TheCBaH/hardcaml-radio86.git"
x-maintenance-intent: ["(latest)"]
x-ai-disclosure: "ai-generated"
x-ai-provider: "Anthropic"
# None of these are in opam-repository yet; pin-depends is not transitive.
pin-depends: [
  ["zipc.dev" "git+https://github.com/dbuenzli/zipc.git#4335e845388b05b9161c8fd58b4ef4363819e43b"]
  ["unlz4.dev" "git+https://github.com/TheCBaH/ocaml-unlz4.git#f5446abf9a4ce4beb92b02ee958f345a6c8171bd"]
  ["fst.dev" "git+https://github.com/TheCBaH/ocaml-fst.git#32d68870539fb7422c86e5d8fc62db8568b173a7"]
  ["ovcd.dev" "git+https://github.com/TheCBaH/ovcd.git#d24473baee9b6df8255b9a464cee60c643cb5bfd"]
  ["err_trace.0.1.0" "git+https://github.com/TheCBaH/err_trace.git#1c7a6ba94c81c70008c594c709e7d37feb38f435"]
  ["hwfrp.dev" "git+https://github.com/TheCBaH/coralview.git#5ff364d51952d98224a27ec233983f167aa350c8"]
  ["rivet.dev" "git+https://github.com/TheCBaH/rivet.git#932dcbd88b2b35846f5959d9d6a9ac2fcf695d91"]
