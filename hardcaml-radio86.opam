# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Observation of an Intel 8080 from waveform traces"
description:
  "Hardcaml i8080 CPU and its harness; reads Verilator or Cyclesim waveforms of an 8080 with hwfrp and decodes bus transfers, instructions and register state, checked in lockstep against Rivet's behavioural model."
maintainer: ["Vladimir Silyaev"]
authors: ["Vladimir Silyaev"]
license: "MIT"
homepage: "https://github.com/TheCBaH/hardcaml-radio86"
bug-reports: "https://github.com/TheCBaH/hardcaml-radio86/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "4.14"}
  "hwfrp"
  "hardcaml"
  "ppx_hardcaml"
  "rivet"
  "jsont"
  "bytesrw"
  "cmdliner"
  "ppx_expect" {with-test}
  "qcheck-core" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/TheCBaH/hardcaml-radio86.git"
x-maintenance-intent: ["(latest)"]
x-ai-disclosure: "ai-generated"
x-ai-provider: "Anthropic"
# None of these are in opam-repository yet; pin-depends is not transitive.
pin-depends: [
  ["zipc.dev" "git+https://github.com/dbuenzli/zipc.git#4335e845388b05b9161c8fd58b4ef4363819e43b"]
  ["unlz4.dev" "git+https://github.com/TheCBaH/ocaml-unlz4.git#1b79f18cb5c7c76cb2e29a329017d78884423feb"]
  ["fst.dev" "git+https://github.com/TheCBaH/ocaml-fst.git#0d6797ad218463775e852f86c81b793924c8d4ab"]
  ["ovcd.dev" "git+https://github.com/TheCBaH/ovcd.git#48a850d6fe8b3573b6ae8427ebf6661099b77c47"]
  ["err_trace.0.3.0" "git+https://github.com/TheCBaH/err_trace.git#8138a417b452e55483028df851cb562fbf175eed"]
  ["hwfrp.dev" "git+https://github.com/TheCBaH/coralview.git#344cc439d8c40a8509a0cb9be9d21d10693ead05"]
