{
  "format": "i8080-observation-manifest/1",
  "id": "hardcaml-vcd",
  "profile": "i8080a/1",
  "description": "The Hardcaml i8080 core (rtl/core.ml) simulated in Cyclesim and written by Vcd.wrap. Vcd.wrap records the pre-edge inputs and outputs of cycle k at the timestamp of the rising edge that ends it, so a T-state is the rising edge where the sample strobe is high, sampled after the edge (the values written with it). Pins are the core's ports; the registers are observation ports.",
  "clock": {
    "path": [
      "inputs",
      "clock"
    ],
    "rule": "after_rising",
    "enable": {
      "path": [
        "outputs",
        "sample"
      ]
    }
  },
  "snapshot": "fetch_accepted",
  "signals": [
    {
      "name": "a",
      "path": [
        "outputs",
        "a"
      ],
      "width": 16,
      "kind": "pin"
    },
    {
      "name": "do",
      "path": [
        "outputs",
        "dout"
      ],
      "width": 8,
      "kind": "pin",
      "valid": [
        "outputs",
        "dout_en"
      ]
    },
    {
      "name": "di",
      "path": [
        "inputs",
        "di"
      ],
      "width": 8,
      "kind": "pin"
    },
    {
      "name": "sync",
      "path": [
        "outputs",
        "sync"
      ],
      "width": 1,
      "kind": "pin"
    },
    {
      "name": "dbin",
      "path": [
        "outputs",
        "dbin"
      ],
      "width": 1,
      "kind": "pin"
    },
    {
      "name": "wr_n",
      "path": [
        "outputs",
        "wr_n"
      ],
      "width": 1,
      "kind": "pin"
    },
    {
      "name": "wait",
      "path": [
        "outputs",
        "wait_"
      ],
      "width": 1,
      "kind": "pin"
    },
    {
      "name": "hlda",
